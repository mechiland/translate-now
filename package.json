{
  "name": "translate-now",
  "version": "0.2.0",
  "private": true,
  "description": "Bring-your-own-key bilingual web page translator powered by LLMs",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "wxt zip && wxt zip -b firefox && wxt zip -b edge",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv2",
    "format": "prettier --write .",
    "test": "vitest run && node --test tests/release/*.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "release:check": "node scripts/release.mjs check",
    "submit:chrome": "node scripts/release.mjs submit chrome",
    "submit:firefox": "node scripts/release.mjs submit firefox",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@radix-ui/colors": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "web-ext": "10.8.0",
    "wxt": "^0.21.5"
  },
  "packageManager": "pnpm@12.18.0",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  }
}
